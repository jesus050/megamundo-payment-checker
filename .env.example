DATABASE_URL=postgresql://postgres:postgres@localhost:5432/megamundo_payments?schema=public
APP_SECRET=megamundo-super-secret-jwt-key-change-in-production-2026

# Orígenes CORS permitidos (separados por coma, sin comodines en producción)
ALLOWED_ORIGINS=http://localhost:5173

# Bancolombia Feature Flag (false por defecto hasta contar con credenciales oficiales)
BANCOLOMBIA_INTEGRATION_ENABLED=false
BANCOLOMBIA_ENV=sandbox

BANCOLOMBIA_CLIENT_ID=
BANCOLOMBIA_CLIENT_SECRET=
BANCOLOMBIA_CALLBACK_URL=

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Integración Zernio (Recepción de SMS y Correos de Bancolombia)
ZERNIO_INTEGRATION_ENABLED=true
ZERNIO_WEBHOOK_SECRET=
